{
  "name": "phpbergen/php86",
  "description": "PHP talk and demonstration of PHP 8.6",
  "homepage": "https://github.com/PHP-Bergen",
  "authors": [
    {
      "name": "Stein Magne Bjørklund",
      "email": "steinmb@smbjorklund.com"
    }
  ],
  "type": "project",
  "license": "MIT",
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.6",
    "ext-io": "*",
    "ext-uri": "*"
  },
  "config": {
    "platform": {
      "php": "8.5"
    }
  },
  "autoload": {
    "psr-4": {
      "phpbergen\\php86\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Phpbergen\\Tests\\": "tests"
    }
  }
}
